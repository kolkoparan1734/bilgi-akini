run = "cd backend && pip install -r requirements.txt && gunicorn --worker-class eventlet -w 1 --bind 0.0.0.0:5000 app:app"

[nix]
channel = "stable-24_05"

[deployment]
build = ["sh", "-c", "pip install -r backend/requirements.txt"]
run = ["sh", "-c", "cd backend && gunicorn --worker-class eventlet -w 1 --bind 0.0.0.0:$PORT app:app"]

[[ports]]
localPort = 5000
externalPort = 80
